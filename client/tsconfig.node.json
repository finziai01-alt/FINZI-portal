{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "declaration": true,
    "strict": true,
    "jsx": "react-jsx"
  },
  "include": ["vite.config.ts"]
}
