# FINZI AI — Environment Variables
# Copy this file to .env and fill in your values before running the servers.

# ============================================================
# SERVER
# ============================================================
PORT=5000
DB_PATH=./db/finzi.db
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ============================================================
# EMAIL — Resend (free tier: 100 emails/day)
# ============================================================
# Get your API key from https://resend.com/api-keys
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your-resend-api-key
EMAIL_FROM=no-reply@finzi.ai

# ============================================================
# SMS — Twilio / Msg91 (optional, free tiers are rare)
# ============================================================
SMS_PROVIDER=none
SMS_API_KEY=your-sms-api-key
SMS_FROM=FINZIAI
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ============================================================
# OCR / Document Extraction — AWS Textract (optional)
# ============================================================
OCR_PROVIDER=none   # aws_textract | azure_form_recognizer | google_document_ai | none
OCR_REGION=ap-south-1
OCR_ACCESS_KEY_ID=your-aws-access-key-id
OCR_SECRET_ACCESS_KEY=your-aws-secret-access-key
OCR_ENDPOINT=

# ============================================================
# GST Portal Filing — GSTN OAuth2 (optional)
# ============================================================
GSTN_ENABLED=false
GSTN_CLIENT_ID=your-gstn-client-id
GSTN_CLIENT_SECRET=your-gstn-client-secret
GSTN_REDIRECT_URI=http://localhost:5000/api/tax/gstn/callback
GSTN_BASE_URL=https://gst.gov.in

# ============================================================
# AI / LLM — Google Gemini + NVIDIA Nemotron (auto-fallback)
# ============================================================
# Get Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Get NVIDIA API key from https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_GLM_MODEL=nvidia/glm-5.3-flash
NVIDIA_VOICE_MODEL=nvidia/nemotron-voice-chat

# ============================================================
# NOTES
# ============================================================
# - JWT_SECRET: used to sign access tokens. Use a strong random value in production.
# - BCRYPT_SALT_ROUNDS: cost factor for password hashing (default 12).
# - DB_PATH: location of the SQLite database file.
# - UPLOAD_DIR: directory where uploaded documents are stored.
# - MAX_FILE_SIZE: max upload size in bytes (default 25 MB).
#
# OPTIONAL INTEGRATIONS (honestly marked "pending integration" when credentials absent):
# - GST Portal / GSTR-2B download: set GSTN_ENABLED=true + OAuth credentials.
# - OCR / document extraction: set OCR_PROVIDER=aws_textract + AWS credentials.
# - Email: set EMAIL_PROVIDER=resend + EMAIL_API_KEY (Resend free tier: 100 emails/day).
# - SMS: set SMS_PROVIDER=twilio + TWILIO credentials (free SMS tiers are rare).
# - AI/LLM: FINZI AI tries Google Gemini → NVIDIA Nemotron → NVIDIA GLM → NVIDIA Voice Chat.
#   If ALL fail, the UI shows "Server Busy hold just a minute" (no raw error surfaced).
